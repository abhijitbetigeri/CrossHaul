# CrossHaul — local secrets. Copy to .env (gitignored) and fill in.

# Nebius Token Factory — open-weights inference for the high-volume, low-reasoning calls.
# Hackathon participants get $50 of credit. https://nebius.com
NEBIUS_API_KEY=

# ElevenLabs — only needed to render the fallback .mp3 (voice/render_fallback.sh).
# The embedded conversational agent needs no key, only a public agent id.
ELEVENLABS_API_KEY=

# Anthropic — the rebalance/procurement decision and operator dialogue.
ANTHROPIC_API_KEY=
